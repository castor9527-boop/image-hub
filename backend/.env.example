# 本地开发 / 本地生产环境变量模板
# 用法：cp backend/.env.example backend/.env
# npm run dev / npm start 时 cwd=backend

# 服务器配置
# 监听端口（默认：3000）
PORT=3000

# 绑定地址（默认：0.0.0.0，表示所有网络接口）
HOSTNAME=0.0.0.0

# 运行环境（development | production）
NODE_ENV=production

# 生产环境允许访问的上游 API 域名，多个域名用逗号分隔
NOVA_ALLOWED_API_HOSTS=api.openai.com,generativelanguage.googleapis.com

# 仅开发环境使用；生产环境请保持 false
NOVA_ALLOW_ANY_UPSTREAM=false

# SQLite 数据库文件路径（相对 cwd=backend）
NOVA_TASK_DB=./data/nova-tasks.sqlite

# 图片存储目录（相对 cwd=backend）
NOVA_IMAGE_DIR=./data/nova-images

# 最大并发图片数
NOVA_TASK_CONCURRENCY=50

# ============================================
# 队列与限流配置（运行时读取，修改 .env 后通常无需重启）
# ============================================

# 全局最大待处理任务数（排队中 + 生成中），达到后返回 503 QUEUE_FULL
NOVA_MAX_QUEUE_SIZE=200

# 限流窗口长度（毫秒）
NOVA_RATE_LIMIT_WINDOW_MS=60000

# 单 IP 在一个窗口内最多创建多少个任务，超过返回 429 RATE_LIMITED
NOVA_RATE_LIMIT_MAX_REQUESTS_PER_IP=10

# 单 API Key 在一个窗口内最多创建多少个任务，超过返回 429 RATE_LIMITED
NOVA_RATE_LIMIT_MAX_REQUESTS_PER_API_KEY=10

# 单 IP 最多同时拥有多少个待处理任务，超过返回 429 TOO_MANY_PENDING_TASKS
NOVA_MAX_PENDING_TASKS_PER_IP=20

# 单 API Key 最多同时拥有多少个待处理任务，超过返回 429 TOO_MANY_PENDING_TASKS
NOVA_MAX_PENDING_TASKS_PER_API_KEY=20

# 队列满/限流时返回给客户端的 Retry-After 秒数
NOVA_RATE_LIMIT_RETRY_AFTER_SECONDS=60

# ============================================
# 提示词广场配置（运行时读取，修改 .env 后通常无需重启）
# ============================================

# 提示词广场模式：1=常驻（直接显示） 2=私密（需密码验证，点七下标题） 3=关闭（完全隐藏）
# 修改 .env 文件后实时生效，无需重启服务
PROMPT_GALLERY_MODE=1
PROMPT_GALLERY_PASSWORD=8848
GGOO_ADMIN_PASSWORD=请设置独立的管理员密码
# Optional local/deployment env file containing the Shuai API credentials and gateway URLs.
# Keep the actual key out of this repository.
GGOO_CONFIG_FILE=
GGOO_TEXT_PROTOCOL=openai-chat-completions
# Optional separate image-generation key. Falls back to GGOO_SERVICE_API_KEY when omitted.
GGOO_IMAGE_API_KEY=
GGOO_IMAGE_GATEWAY_BASE_URL=
